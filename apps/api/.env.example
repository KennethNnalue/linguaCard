# ── App ────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:4200

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=                             # postgres://user:pass@host:5432/dbname

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET=                              # generate a strong random string

# ── AI providers ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=                          # aistudio.google.com — used for TTS + vision fallback
ANTHROPIC_API_KEY=                       # optional — story generation (highest quality)
OPENAI_API_KEY=                          # deprecated — Whisper replaced by Groq
AI_DEFAULT_PROVIDER=gemini               # gemini | anthropic | openrouter

# ── OpenRouter (enrichment + story generation — single key covers Haiku, Sonnet, Gemini Flash) ──
# Get key: openrouter.ai → Keys → Create key (starts sk-or-v1-)
OPENROUTER_API_KEY=                      # required
OPENROUTER_VISION_MODEL=google/gemma-4-26b-a4b-it:free   # legacy single-pass fallback
OPENROUTER_TEXT_MODEL=google/gemma-4-26b-a4b-it:free     # generic fallback

# ── Per-task model routing ─────────────────────────────────────────────────────
# Change these to swap models without code changes. All billed via OPENROUTER_API_KEY.
#
# Task                 Model                           Cost/1K ops (approx)
# Image extraction     GeminiAdapter (direct)          $0.99  (via GEMINI_API_KEY)
# Word enrichment      Haiku 4.5 via OpenRouter        $4.60  per 1000 words
# Story — Pro tier     Sonnet 4.6 via OpenRouter       $9.30  per 100 stories
# Story — Free tier    Gemini 2.5 Flash via OpenRouter $1.48  per 100 stories
ENRICHMENT_MODEL=anthropic/claude-haiku-4-5
STORY_MODEL_PRO=anthropic/claude-sonnet-4-6
STORY_MODEL_FREE=google/gemini-2.5-flash

# ── Groq (Whisper STT — karaoke timestamps, free tier) ────────────────────────
GROQ_API_KEY=                            # console.groq.com → API Keys (starts gsk_)

# ── Google Cloud TTS (word pronunciation + story narration) ───────────────────
# 1. Enable API: console.cloud.google.com/apis/library/texttospeech.googleapis.com
# 2. Create service account: IAM & Admin → Service Accounts → linguacard-tts
# 3. Download JSON key, then base64 encode: cat key.json | base64 | tr -d '\n'
# Free tier: WaveNet voices = 4M chars/month. DO NOT use Gemini-TTS voice names
# here — they have no free tier and are billed from character 0.
GOOGLE_CLOUD_TTS_KEY_BASE64=             # base64-encoded service account JSON
GOOGLE_CLOUD_TTS_VOICE=de-DE-Wavenet-B  # see: cloud.google.com/text-to-speech/docs/voices
GOOGLE_CLOUD_TTS_LANGUAGE=de-DE

# ── Cloudflare R2 (audio file storage) ────────────────────────────────────────
# Create a bucket at dash.cloudflare.com → R2, then generate an API token
# with "Object Read & Write" permissions for this bucket.
R2_ACCOUNT_ID=                           # Cloudflare account ID (40-char hex)
R2_ACCESS_KEY_ID=                        # R2 API token → Access Key ID
R2_SECRET_ACCESS_KEY=                    # R2 API token → Secret Access Key
R2_BUCKET=                               # bucket name, e.g. linguacard-audio
R2_PUBLIC_URL=                           # public URL, e.g. https://audio.linguacard.app

# ── Storage (fallback) ─────────────────────────────────────────────────────────
AI_STORAGE_BUCKET=lingua-card-audio-dev
API_PUBLIC_URL=https://linguacard-api.onrender.com
