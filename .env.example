# ── NestJS API (set these in Render dashboard) ────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
NODE_ENV=production
CORS_ORIGIN=https://your-app.vercel.app   # comma-separated if multiple origins
PORT=3001                                 # Render sets this automatically
JWT_SECRET=change-me-in-production

# Public HTTPS URL of this API — used to build audio file URLs stored in the DB.
# Must match your Render service URL exactly (no trailing slash).
API_PUBLIC_URL=https://linguacard-api.onrender.com

# ── AI providers ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=                           # aistudio.google.com
ANTHROPIC_API_KEY=                        # optional
OPENAI_API_KEY=                           # optional — enables Whisper timestamps
ELEVENLABS_API_KEY=                       # required for podcast dialogue generation
ELEVENLABS_DIALOGUE_MODEL=eleven_v3
ELEVENLABS_FEMALE_VOICE_IDS=              # optional comma-separated preferred female voices
ELEVENLABS_MALE_VOICE_IDS=                # optional comma-separated preferred male voices
AI_DEFAULT_PROVIDER=gemini

# ── Cloudflare R2 audio storage ───────────────────────────────────────────────
# Leave all R2_* vars blank to use local disk (development default).
# To set up: dash.cloudflare.com → R2 → Create bucket → Manage API Tokens
R2_ACCOUNT_ID=                            # 40-char hex from Cloudflare dashboard
R2_ACCESS_KEY_ID=                         # R2 token Access Key ID
R2_SECRET_ACCESS_KEY=                     # R2 token Secret Access Key
R2_BUCKET=linguacard-audio                # your bucket name
R2_PUBLIC_URL=https://pub-xxxx.r2.dev     # enable "Public access" on bucket to get this URL
                                          # or use a custom domain: https://audio.yourdomain.com

# ── Angular (set this in Vercel dashboard) ────────────────────────────────────
API_URL=https://linguacard-api.onrender.com
